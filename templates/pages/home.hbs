<section class="hero media-panel{{#if images.hero}} has-image{{/if}}"{{#if images.hero}} style="background-image:url('{{{images.hero.src}}}')"{{/if}}>
  <div class="container hero-inner">
    <span class="eyebrow">{{business.name}}</span>
    <h1>{{content.home.headline}}</h1>
    {{#if content.home.subheadline}}
      <p class="hero-sub lede">{{content.home.subheadline}}</p>
    {{/if}}
    {{#if content.home.ctaText}}
      <div class="btn-row">
        <a class="btn btn-primary" href="{{content.home.ctaLink}}">{{content.home.ctaText}}</a>
        {{#if pages.leistungen}}
          <a class="btn btn-secondary" href="leistungen.html">Leistungen ansehen</a>
        {{/if}}
      </div>
    {{/if}}
  </div>
</section>

{{#if pages.leistungen}}
<section class="section section-muted reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">Angebot</span>
      <h2>Unsere Leistungen</h2>
    </div>
    <div class="card-grid">
      {{#each content.leistungen.services}}
        <div class="card">
          <span class="card-index">{{indexNum @index}}</span>
          <h3>{{this.name}}</h3>
          <p>{{this.description}}</p>
        </div>
      {{/each}}
    </div>
    <p class="center" style="margin-top:2.5rem;">
      <a class="btn btn-secondary" href="leistungen.html">Alle Leistungen ansehen</a>
    </p>
  </div>
</section>
{{/if}}

{{#if pages.kontakt}}
<section class="media-panel reveal{{#if images.cta}} has-image{{/if}}"{{#if images.cta}} style="background-image:url('{{{images.cta.src}}}')"{{/if}}>
  <div class="container center">
    <span class="eyebrow">Kontakt</span>
    <h2>Interesse geweckt?</h2>
    <p class="lede" style="margin:0 auto 1.5rem;">Nehmen Sie jetzt Kontakt mit uns auf – wir freuen uns auf Ihre Nachricht.</p>
    <a class="btn btn-primary" href="kontakt.html">Kontakt aufnehmen</a>
  </div>
</section>
{{/if}}
