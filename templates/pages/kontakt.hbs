<section class="section">
  <div class="container">
    <h1>{{content.kontakt.title}}</h1>
    {{#if content.kontakt.intro}}
      <p>{{content.kontakt.intro}}</p>
    {{/if}}

    <div class="contact-grid">
      <div class="contact-details">
        {{#if business.address}}
          <p><strong>Adresse</strong><br>{{business.address}}</p>
        {{/if}}
        {{#if business.phone}}
          <p><strong>Telefon</strong><br><a href="tel:{{business.phone}}">{{business.phone}}</a></p>
        {{/if}}
        {{#if business.email}}
          <p><strong>E-Mail</strong><br><a href="mailto:{{business.email}}">{{business.email}}</a></p>
        {{/if}}
        {{#if content.kontakt.openingHours}}
          <p><strong>Öffnungszeiten</strong><br>{{content.kontakt.openingHours}}</p>
        {{/if}}
        {{#if business.address}}
          <p><a class="btn btn-secondary" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query={{encodedAddress}}">Route planen</a></p>
        {{/if}}
      </div>
    </div>
  </div>
</section>
