<section class="section reveal">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Termin buchen</span>
      <h1>{{content.buchungen.title}}</h1>
      {{#if content.buchungen.intro}}
        <p class="lede">{{content.buchungen.intro}}</p>
      {{/if}}
    </div>

    <div class="booking-tabs">
      <button type="button" class="booking-tab active" data-tab="buchen">Buchungen</button>
      <button type="button" class="booking-tab" data-tab="kalender" id="tab-kalender-btn" hidden>Kalender</button>
    </div>

    <div class="booking-panel" data-panel="buchen">
      <form id="booking-form" class="booking-form">
        <div class="grid-2-site">
          <label>Name*
            <input type="text" name="name" required>
          </label>
          <label>E-Mail*
            <input type="email" name="email" required>
          </label>
          <label>Datum*
            <input type="date" name="date" required>
          </label>
          <label>Uhrzeit*
            <input type="time" name="time" required>
          </label>
        </div>
        <label>Nachricht (optional)
          <textarea name="note" rows="3"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Termin anfragen</button>
        <p id="booking-status" class="booking-status" hidden></p>
      </form>
    </div>

    <div class="booking-panel" data-panel="kalender" hidden>
      <div id="admin-bookings-list"></div>
    </div>
  </div>
</section>

<script>
(function () {
  var form = document.getElementById('booking-form');
  var status = document.getElementById('booking-status');

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var payload = {
      name: form.name.value,
      email: form.email.value,
      date: form.date.value,
      time: form.time.value,
      note: form.note.value,
    };
    status.hidden = false;
    status.className = 'booking-status';
    status.textContent = 'Wird gebucht…';

    fetch('/api/bookings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (res) {
        return res.json().then(function (body) {
          if (!res.ok) throw new Error(body.error || 'Buchung fehlgeschlagen.');
          return body;
        });
      })
      .then(function () {
        status.className = 'booking-status booking-status-success';
        status.textContent = 'Buchung erfolgreich erstellt! Eine Bestätigungs-E-Mail wurde an ' + payload.email + ' gesendet.';
        form.reset();
      })
      .catch(function (err) {
        status.className = 'booking-status booking-status-error';
        status.textContent = 'Fehler: ' + err.message + ' (Hinweis: Buchung funktioniert aktuell nur, wenn diese Seite über "Im Browser öffnen" aus dem Builder aufgerufen wird.)';
      });
  });

  // --- Tabs: "Buchungen" ist immer Standard, "Kalender" taucht nur für
  // eingeloggte Admins überhaupt als Tab auf (siehe checkSession unten). ---
  var tabs = document.querySelectorAll('.booking-tab');
  var panels = document.querySelectorAll('.booking-panel');

  function activateTab(name) {
    tabs.forEach(function (tab) {
      tab.classList.toggle('active', tab.dataset.tab === name);
    });
    panels.forEach(function (panel) {
      panel.hidden = panel.dataset.panel !== name;
    });
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { activateTab(tab.dataset.tab); });
  });

  var kalenderTabBtn = document.getElementById('tab-kalender-btn');
  var listEl = document.getElementById('admin-bookings-list');

  function renderBookings(bookings) {
    if (!bookings.length) {
      listEl.innerHTML = '<p class="hint">Noch keine Termine gebucht.</p>';
      return;
    }
    var byDate = {};
    bookings.forEach(function (b) {
      (byDate[b.date] = byDate[b.date] || []).push(b);
    });
    var dates = Object.keys(byDate).sort();
    listEl.innerHTML = dates
      .map(function (date) {
        var items = byDate[date];
        var rows = items
          .map(function (b) {
            var note = b.note ? '<br><em>' + b.note + '</em>' : '';
            return '<li><strong>' + b.time + '</strong> – ' + b.name + ' (' + b.email + ')' + note + '</li>';
          })
          .join('');
        return '<div class="admin-day"><h4>' + date + '</h4><ul>' + rows + '</ul></div>';
      })
      .join('');
  }

  function loadBookings() {
    fetch('/api/bookings')
      .then(function (res) { return res.json(); })
      .then(function (data) { renderBookings(data.bookings || []); });
  }

  fetch('/api/session')
    .then(function (res) { return res.json(); })
    .then(function (data) {
      if (data.isAdmin && kalenderTabBtn) {
        kalenderTabBtn.hidden = false;
        loadBookings();
      }
    });
})();
</script>
