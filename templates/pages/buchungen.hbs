<section class="section reveal">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Termin buchen</span>
      <h1>{{content.buchungen.title}}</h1>
      {{#if content.buchungen.intro}}
        <p class="lede">{{content.buchungen.intro}}</p>
      {{/if}}
    </div>

    <div class="booking-grid{{#if images.buchungen}} has-image{{/if}}">
      <form
        id="booking-form"
        class="booking-form"
        data-start-hour="{{content.buchungen.startHour}}"
        data-end-hour="{{content.buchungen.endHour}}"
        data-slot-interval="{{content.buchungen.slotInterval}}"
      >
        <div class="grid-2-site">
          <label>Name*
            <input type="text" name="name" required>
          </label>
          <label>E-Mail*
            <input type="email" name="email" required>
          </label>
          <label>Datum*
            <input type="date" name="date" required>
          </label>
          <label>Uhrzeit*
            <select name="time" required disabled>
              <option value="">Bitte zuerst Datum wählen</option>
            </select>
          </label>
        </div>
        <label>Nachricht (optional)
          <textarea name="note" rows="3"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Termin anfragen</button>
        <p class="booking-form-hint">Dies ist zunächst eine Anfrage – Sie erhalten zuerst eine Eingangsbestätigung und anschließend eine Bestätigung oder Absage.</p>
        <p id="booking-status" class="booking-status" hidden></p>
      </form>
      {{#if images.buchungen}}
        <div class="booking-media">
          <img src="{{{images.buchungen.src}}}" alt="{{images.buchungen.alt}}" loading="lazy">
        </div>
      {{/if}}
    </div>
  </div>
</section>

<script>
(function () {
  function formatDate(d) {
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }

  function pad2(n) { return String(n).padStart(2, '0'); }

  // --- Einstellungen einmalig mit den Werten aus dem Builder vorbelegen,
  // damit /api/day-info von Anfang an sinnvolle Werte liefert (Admin kann sie
  // später jederzeit über die Verwaltung ändern, siehe assets/js/admin.js). ---
  var form = document.getElementById('booking-form');
  var status = document.getElementById('booking-status');
  var dateInput = form.querySelector('input[name="date"]');
  var timeSelect = form.querySelector('select[name="time"]');

  var todayIso = formatDate(new Date());
  dateInput.min = todayIso;

  fetch('/api/settings/seed', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      startHour: parseInt(form.dataset.startHour, 10),
      endHour: parseInt(form.dataset.endHour, 10),
      slotInterval: parseInt(form.dataset.slotInterval, 10),
    }),
  }).catch(function () {});

  // --- Zeit-Dropdown: hängt vom gewählten Datum ab (Öffnungszeiten an diesem
  // Wochentag + Mittagspause + bereits vergebene Zeiten werden ausgeschlossen). ---
  function refreshTimeOptions() {
    var dateVal = dateInput.value;
    if (!dateVal) {
      timeSelect.disabled = true;
      timeSelect.innerHTML = '<option value="">Bitte zuerst Datum wählen</option>';
      return;
    }
    timeSelect.disabled = true;
    timeSelect.innerHTML = '<option value="">Lade Verfügbarkeit…</option>';

    fetch('/api/day-info?date=' + encodeURIComponent(dateVal))
      .then(function (res) { return res.json(); })
      .then(function (info) {
        if (!info.enabled) {
          timeSelect.innerHTML = '<option value="">An diesem Tag sind keine Termine möglich</option>';
          timeSelect.disabled = true;
          return;
        }
        var taken = info.taken || [];
        var hasBreak = info.breakStart != null && info.breakEnd != null;
        var options = ['<option value="">Bitte wählen</option>'];
        for (var m = info.startHour * 60; m < info.endHour * 60; m += info.slotInterval) {
          if (hasBreak && m >= info.breakStart * 60 && m < info.breakEnd * 60) continue;
          var label = pad2(Math.floor(m / 60)) + ':' + pad2(m % 60);
          if (taken.indexOf(label) !== -1) continue;
          options.push('<option value="' + label + '">' + label + ' Uhr</option>');
        }
        if (options.length === 1) {
          timeSelect.innerHTML = '<option value="">Alle Termine an diesem Tag sind bereits vergeben</option>';
          timeSelect.disabled = true;
          return;
        }
        timeSelect.innerHTML = options.join('');
        timeSelect.disabled = false;
      })
      .catch(function () {
        timeSelect.innerHTML = '<option value="">Verfügbarkeit konnte nicht geladen werden</option>';
      });
  }

  dateInput.addEventListener('change', refreshTimeOptions);

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var payload = {
      name: form.name.value,
      email: form.email.value,
      date: form.date.value,
      time: form.time.value,
      note: form.note.value,
    };
    status.hidden = false;
    status.className = 'booking-status';
    status.textContent = 'Wird angefragt…';

    fetch('/api/bookings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (res) {
        return res.json().then(function (body) {
          if (!res.ok) throw new Error(body.error || 'Anfrage fehlgeschlagen.');
          return body;
        });
      })
      .then(function () {
        status.className = 'booking-status booking-status-success';
        status.textContent = 'Anfrage erhalten! Eine Eingangsbestätigung wurde an ' + payload.email + ' gesendet. Sie erhalten eine weitere E-Mail, sobald der Termin bestätigt oder abgelehnt wurde.';
        form.reset();
        refreshTimeOptions();
        if (window.AdminPanel) window.AdminPanel.refresh();
      })
      .catch(function (err) {
        status.className = 'booking-status booking-status-error';
        status.textContent = 'Fehler: ' + err.message + ' (Hinweis: Buchung funktioniert aktuell nur, wenn diese Seite über "Im Browser öffnen" aus dem Builder aufgerufen wird.)';
      });
  });
})();
</script>
