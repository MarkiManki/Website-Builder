<section class="section reveal">
  <div class="container">
    <div class="about-grid{{#if images.about}} has-image{{/if}}">
      <div class="section-head">
        <span class="eyebrow">Über uns</span>
        <h1>{{content.ueberUns.title}}</h1>
        {{#if content.ueberUns.text}}
          <p class="lede">{{content.ueberUns.text}}</p>
        {{/if}}
      </div>
      {{#if images.about}}
        <div class="about-media">
          <img src="{{{images.about.src}}}" alt="{{images.about.alt}}" loading="lazy">
        </div>
      {{/if}}
    </div>
  </div>
</section>

{{#if content.ueberUns.teamMembers.length}}
<section class="section section-muted reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">Team</span>
      <h2>Die Menschen dahinter</h2>
    </div>
    <div class="card-grid">
      {{#each content.ueberUns.teamMembers}}
        <div class="card">
          {{#if this.photo}}
            <div class="card-icon card-icon-photo"><img src="{{{this.photo}}}" alt="{{this.name}}" loading="lazy"></div>
          {{else}}
            <div class="card-icon">{{this.name.[0]}}</div>
          {{/if}}
          <h3>{{this.name}}</h3>
          {{#if this.role}}<p class="card-role">{{this.role}}</p>{{/if}}
          {{#if this.text}}<p>{{this.text}}</p>{{/if}}
        </div>
      {{/each}}
    </div>
  </div>
</section>
{{/if}}
