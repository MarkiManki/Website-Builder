<section class="section reveal">
  <div class="container legal">
    <div class="section-head">
      <span class="eyebrow">Rechtliches</span>
      <h1>Impressum</h1>
    </div>

    <div class="legal-block">
      <h3>Angaben gemäß gesetzlicher Anbieterkennzeichnung</h3>
      <p>
        {{content.impressum.inhaber}}<br>
        {{#if content.impressum.firma}}{{content.impressum.firma}}<br>{{/if}}
        {{content.impressum.strasse}}<br>
        {{content.impressum.plzOrt}}<br>
        {{content.impressum.land}}
      </p>
    </div>

    <div class="legal-block">
      <h3>Kontakt</h3>
      <p>
        {{#if content.impressum.telefon}}Telefon: {{content.impressum.telefon}}<br>{{/if}}
        {{#if content.impressum.email}}E-Mail: {{content.impressum.email}}<br>{{/if}}
      </p>
    </div>

    {{#if content.impressum.ustId}}
    <div class="legal-block">
      <h3>Umsatzsteuer-ID</h3>
      <p>{{content.impressum.ustId}}</p>
    </div>
    {{/if}}

    {{#if content.impressum.handelsregister}}
    <div class="legal-block">
      <h3>Handelsregister</h3>
      <p>{{content.impressum.handelsregister}}</p>
    </div>
    {{/if}}

    {{#if content.impressum.aufsichtsbehoerde}}
    <div class="legal-block">
      <h3>Aufsichtsbehörde</h3>
      <p>{{content.impressum.aufsichtsbehoerde}}</p>
    </div>
    {{/if}}

    {{#if content.impressum.verantwortlicher}}
    <div class="legal-block">
      <h3>Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV</h3>
      <p>{{content.impressum.verantwortlicher}}</p>
    </div>
    {{/if}}

    <p class="impressum-hinweis"><em>Hinweis: Dieses Impressum wurde automatisiert erstellt. Bitte rechtlich prüfen lassen, bevor die Website veröffentlicht wird.</em></p>
  </div>
</section>
