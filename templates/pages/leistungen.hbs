<section class="section">
  <div class="container">
    <h1>{{content.leistungen.title}}</h1>
    {{#if content.leistungen.intro}}
      <p>{{content.leistungen.intro}}</p>
    {{/if}}
  </div>
</section>

<section class="section section-muted">
  <div class="container">
    <div class="card-grid">
      {{#each content.leistungen.services}}
        <div class="card">
          <h3>{{this.name}}</h3>
          <p>{{this.description}}</p>
        </div>
      {{/each}}
    </div>
  </div>
</section>
