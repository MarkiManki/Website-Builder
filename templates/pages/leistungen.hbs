<section class="section reveal">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Leistungen</span>
      <h1>{{content.leistungen.title}}</h1>
      {{#if content.leistungen.intro}}
        <p class="lede">{{content.leistungen.intro}}</p>
      {{/if}}
    </div>
  </div>
</section>

<section class="section section-muted reveal">
  <div class="container">
    {{#if images.services}}
      <div class="section-banner">
        <img src="{{{images.services.src}}}" alt="{{images.services.alt}}" loading="lazy">
      </div>
    {{/if}}
    <div class="card-grid">
      {{#each content.leistungen.services}}
        <div class="card">
          <div class="card-icon">{{this.name.[0]}}</div>
          <h3>{{this.name}}</h3>
          <p>{{this.description}}</p>
        </div>
      {{/each}}
    </div>
  </div>
</section>
