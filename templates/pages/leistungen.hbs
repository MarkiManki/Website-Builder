<section class="media-panel reveal{{#if images.services}} has-image{{/if}}"{{#if images.services}} style="background-image:url('{{{images.services.src}}}')"{{/if}}>
  <div class="container">
    <span class="eyebrow">Leistungen</span>
    <h1>{{content.leistungen.title}}</h1>
    {{#if content.leistungen.intro}}
      <p class="lede">{{content.leistungen.intro}}</p>
    {{/if}}
  </div>
</section>

<section class="section section-muted reveal">
  <div class="container">
    <div class="card-grid">
      {{#each content.leistungen.services}}
        <div class="card">
          <div class="card-icon">{{this.name.[0]}}</div>
          <h3>{{this.name}}</h3>
          <p>{{this.description}}</p>
        </div>
      {{/each}}
    </div>
  </div>
</section>
