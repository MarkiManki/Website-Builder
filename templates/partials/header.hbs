<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{assetPrefix}}index.html">
      {{#if business.logo}}
        <img class="brand-logo" src="{{{business.logo}}}" alt="">
      {{else}}
        <span class="brand-logo brand-logo-badge">{{business.name.[0]}}</span>
      {{/if}}
      {{#if business.logoText}}
        <span class="brand-text">{{business.logoText}}</span>
      {{else}}
        <span class="brand-text">{{business.name}}</span>
      {{/if}}
    </a>
    {{> nav}}
    <div class="admin-corner">
      <button type="button" id="admin-corner-btn" class="admin-corner-btn">Anmelden</button>
      <div id="nav-login-dropdown" class="nav-login-dropdown" hidden>
        <form id="nav-login-form">
          <label>Benutzername oder E-Mail
            <input type="text" name="identifier" autocomplete="username" required>
          </label>
          <label>Passwort
            <input type="password" name="password" autocomplete="current-password" required>
          </label>
          <button type="submit" class="btn btn-primary">Anmelden</button>
          <p id="nav-login-error" class="nav-login-error" hidden></p>
        </form>
      </div>
    </div>
    <button type="button" class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
