<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{assetPrefix}}index.html">
      {{#if business.logo}}
        <img class="brand-logo" src="{{{business.logo}}}" alt="">
      {{else}}
        <span class="brand-logo brand-logo-badge">{{business.name.[0]}}</span>
      {{/if}}
      {{#if business.logoText}}
        <span class="brand-text">{{business.logoText}}</span>
      {{else}}
        <span class="brand-text">{{business.name}}</span>
      {{/if}}
    </a>
    {{> nav}}
    <button type="button" class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
