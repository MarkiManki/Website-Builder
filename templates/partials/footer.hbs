<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {{currentYear}} {{business.name}}. Alle Rechte vorbehalten.</p>
    <div class="footer-right">
      <ul class="social-links">
        {{#if business.social.facebook}}
          <li><a href="{{business.social.facebook}}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H7.9V12h2.6V9.8c0-2.6 1.5-4 3.8-4 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
          </a></li>
        {{/if}}
        {{#if business.social.instagram}}
          <li><a href="{{business.social.instagram}}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a></li>
        {{/if}}
        {{#if business.social.x}}
          <li><a href="{{business.social.x}}" target="_blank" rel="noopener" aria-label="X (Twitter)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg>
          </a></li>
        {{/if}}
        {{#if business.social.linkedin}}
          <li><a href="{{business.social.linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.5v-5.6c0-1.3-.5-2.3-1.8-2.3-1 0-1.6.7-1.9 1.3-.1.2-.1.6-.1.9v5.7H9.6s.1-9.3 0-10.3h3.5v1.5a3.5 3.5 0 0 1 3.1-1.7c2.3 0 4 1.5 4 4.7v5.8ZM7.8 8.6a2 2 0 1 1 0-4.1 2 2 0 0 1 0 4.1ZM6 20.4h3.5V10.1H6v10.3Z"/></svg>
          </a></li>
        {{/if}}
      </ul>
      <ul class="footer-links">
        {{#each footerLinks}}
          <li><a href="{{this.href}}">{{this.label}}</a></li>
        {{/each}}
      </ul>
    </div>
  </div>
</footer>
