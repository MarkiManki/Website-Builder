<!doctype html>
<html lang="de" class="theme-{{type}}">
<head>
  <meta charset="utf-8">
  <title>{{seoTitle}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{seoDescription}}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{{design.googleFontsUrl}}}">
  {{#if preview}}
    <style>{{{inlineCss}}}</style>
  {{else}}
    <link rel="stylesheet" href="{{assetPrefix}}css/base.css">
  {{/if}}
  <style>
    :root {
      --primary: {{design.primaryColor}};
      --radius: {{design.radius}};
      --font-heading: {{design.fontHeading}};
      --font-body: {{design.fontBody}};
    }
  </style>
</head>
<body>
  {{> header}}
  {{> nav}}
  <main>
    {{{body}}}
  </main>
  {{> footer}}
  {{#if preview}}
    <script>{{{inlineJs}}}</script>
    <script>
      document.addEventListener('click', function (event) {
        var link = event.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || /^([a-z]+:|#)/i.test(href)) return;
        event.preventDefault();
        window.parent.postMessage({ source: 'website-builder-preview', href: href }, '*');
      });
    </script>
  {{else}}
    <script src="{{assetPrefix}}js/site.js"></script>
  {{/if}}
</body>
</html>
