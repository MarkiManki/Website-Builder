# Kopieren nach ".env" und den eigenen kostenlosen Pexels-API-Key eintragen.
# Key holen: https://www.pexels.com/api/ (kostenlos, nur E-Mail nötig)
# Ohne Key funktioniert das Tool weiterhin, nur ohne automatische Fotos.
PEXELS_API_KEY=

# Optional: eigener SMTP-Zugang für echten Versand der Terminbestätigungen
# (Buchungsseite). Ohne diese Angaben wird automatisch ein kostenloses
# Ethereal-Testkonto verwendet – die Mail wird nicht wirklich zugestellt,
# aber eine Vorschau-URL landet im Server-Log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Terminbuchung" <no-reply@example.com>
